# ==========================================
# AI Placement Agent - Root Environment Variables
# ==========================================

# Active AI Text Generation Provider (gemini | openai)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Default Provider - Free Tier Eligible)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-Compatible API Configuration (Alternative Provider / Embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Vector Embeddings Subsystem (Separate from chat generation)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Web Intelligence Subsystem (Separate from chat generation)
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=

# MongoDB Connection String (Required for candidate profile persistence)
MONGODB_URI=mongodb://localhost:27017/placement_agent

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Abuse Protection & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
